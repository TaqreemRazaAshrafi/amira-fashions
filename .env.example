# Public runtime config. NEVER put secret keys in a VITE_ variable —
# everything prefixed with VITE_ is inlined into the client bundle.
VITE_API_BASE_URL=https://api.amirafashions.com/v1
VITE_USE_MOCK_API=true
VITE_SITE_URL=https://amirafashions.com
VITE_INSTAGRAM_HANDLE=amira__fashions
VITE_WHATSAPP_NUMBER=919000000000
VITE_CONTACT_EMAIL=hello@amirafashions.com
# Publishable (public) gateway key only. The secret key lives on the server.
VITE_RAZORPAY_KEY_ID=
